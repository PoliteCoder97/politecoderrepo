# Copy to .env and fill in secrets.
# GitHub PAT needs repo scope (contents: write) for the target repository.

GITHUB_TOKEN=
REPO_NAME=PoliteCoder97/politecoderrepo
BRANCH_NAME=develop

# Daily run time (24h clock) in SCHEDULE_TIMEZONE (default UTC).
# Example: 03:00 in that zone.
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=UTC
